{
  "name": "@arbre/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system : tokens, art.css, polices, primitives Svelte.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles/index.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./art-classes": "./src/art-classes.ts",
    "./primitives": "./src/primitives/index.ts",
    "./fonts/*": "./src/fonts/*",
    "./motion": "./src/motion.ts",
    "./i18n": "./src/i18n.ts",
    "./markdown": "./src/markdown.ts",
    "./attachments": "./src/attachments.ts"
  },
  "scripts": {
    "check": "npm run typecheck && npm run contrast:check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "contrast:check": "node scripts/contrast.mjs --strict",
    "icons:ink": "node scripts/ink-icons.mjs && prettier --write src/primitives/icons.ts src/primitives/ornaments.ts"
  },
  "svelte": "./src/index.ts",
  "peerDependencies": {
    "svelte": "^5"
  }
}
