{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "target": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "slot"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "group"
            ],
            "additionalProperties": false
          }
        ]
      },
      "level": {
        "type": "number",
        "enum": [
          1,
          2,
          3
        ]
      },
      "text": {
        "type": "string",
        "pattern": "\\S"
      },
      "availableWhen": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "required": [
      "id",
      "target",
      "level",
      "text",
      "availableWhen"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "read": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "read"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "unlocked": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "unlocked"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "searched": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "searched"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "visited": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "visited"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "locked": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "locked"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "groupLocked": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "groupLocked"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "secret": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "secret"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lockedCount": {
              "type": "object",
              "properties": {
                "gte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "gte"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "lockedCount"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "all": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
