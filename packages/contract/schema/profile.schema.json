{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "settings": {
      "type": "object",
      "properties": {
        "textScale": {
          "type": "number",
          "enum": [
            0.875,
            1,
            1.25,
            1.5,
            2
          ]
        },
        "readScale": {
          "default": 1,
          "type": "number",
          "enum": [
            0.9,
            1,
            1.15,
            1.3,
            1.5
          ]
        },
        "sideWidth": {
          "default": 440,
          "type": "integer",
          "minimum": 360,
          "maximum": 1040
        },
        "layout": {
          "default": "investigate",
          "type": "string",
          "enum": [
            "investigate",
            "read",
            "tree"
          ]
        },
        "cardPosition": {
          "default": {
            "x": 1,
            "y": 1
          },
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "readingFont": {
          "type": "string",
          "enum": [
            "default",
            "hyperlegible",
            "dyslexic"
          ]
        },
        "lineSpacing": {
          "type": "string",
          "enum": [
            "default",
            "wide",
            "wider"
          ]
        },
        "letterSpacing": {
          "type": "boolean"
        },
        "transcriptByDefault": {
          "type": "boolean"
        },
        "replaceHandwriting": {
          "type": "boolean"
        },
        "highContrast": {
          "type": "boolean"
        },
        "reducePaperTexture": {
          "type": "boolean"
        },
        "colorVision": {
          "type": "string",
          "enum": [
            "default",
            "protanopia",
            "deuteranopia",
            "tritanopia"
          ]
        },
        "motion": {
          "type": "string",
          "enum": [
            "system",
            "reduced",
            "full"
          ]
        },
        "hints": {
          "type": "object",
          "properties": {
            "preset": {
              "anyOf": [
                {
                  "type": "number",
                  "enum": [
                    0,
                    1,
                    2,
                    3
                  ]
                },
                {
                  "type": "string",
                  "const": "custom"
                }
              ]
            },
            "unreadBadges": {
              "type": "boolean"
            },
            "exhaustedTerms": {
              "type": "boolean"
            },
            "placeCounters": {
              "type": "boolean"
            },
            "whereToLook": {
              "type": "boolean"
            },
            "groupCounter": {
              "type": "boolean"
            },
            "progressiveHints": {
              "type": "boolean"
            }
          },
          "required": [
            "preset",
            "unreadBadges",
            "exhaustedTerms",
            "placeCounters",
            "whereToLook",
            "groupCounter",
            "progressiveHints"
          ],
          "additionalProperties": false
        },
        "validation": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ]
        },
        "showTimer": {
          "type": "boolean"
        },
        "volume": {
          "type": "object",
          "properties": {
            "master": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "music": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ambience": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sfx": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ui": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "master",
            "music",
            "ambience",
            "sfx",
            "ui"
          ],
          "additionalProperties": false
        },
        "mono": {
          "type": "boolean"
        },
        "muteInBackground": {
          "type": "boolean"
        },
        "haptics": {
          "type": "boolean"
        },
        "longPressMs": {
          "type": "number",
          "enum": [
            300,
            400,
            600
          ]
        },
        "confirmClear": {
          "type": "boolean"
        },
        "inputGlyphs": {
          "type": "string",
          "enum": [
            "auto",
            "keyboard",
            "gamepad"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "system",
            "fr",
            "en"
          ]
        },
        "pickerDescriptions": {
          "type": "boolean"
        },
        "describeMarks": {
          "type": "boolean"
        }
      },
      "required": [
        "textScale",
        "readingFont",
        "lineSpacing",
        "letterSpacing",
        "transcriptByDefault",
        "replaceHandwriting",
        "highContrast",
        "reducePaperTexture",
        "colorVision",
        "motion",
        "hints",
        "validation",
        "showTimer",
        "volume",
        "mono",
        "muteInBackground",
        "haptics",
        "longPressMs",
        "confirmClear",
        "inputGlyphs"
      ],
      "additionalProperties": false
    },
    "achievements": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "completed": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "bestTimedMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "endings": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        },
        "required": [
          "endings"
        ],
        "additionalProperties": false
      }
    },
    "tutorial": {
      "type": "object",
      "properties": {
        "done": {
          "type": "boolean"
        },
        "seen": {
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "done",
        "seen"
      ],
      "additionalProperties": false
    },
    "reports": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "string",
            "pattern": "^[A-Z]{1,8}-\\d{4,}$"
          },
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22}$"
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "summary": {
            "type": "string",
            "maxLength": 80
          }
        },
        "required": [
          "ticket",
          "token",
          "createdAt",
          "summary"
        ],
        "additionalProperties": false
      }
    },
    "changelogSeen": {
      "type": "string",
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  },
  "required": [
    "schemaVersion",
    "settings",
    "achievements",
    "completed"
  ],
  "additionalProperties": false
}
