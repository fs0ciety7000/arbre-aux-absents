{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "textScale": {
      "type": "number",
      "enum": [
        0.875,
        1,
        1.25,
        1.5,
        2
      ]
    },
    "readingFont": {
      "type": "string",
      "enum": [
        "default",
        "hyperlegible",
        "dyslexic"
      ]
    },
    "lineSpacing": {
      "type": "string",
      "enum": [
        "default",
        "wide",
        "wider"
      ]
    },
    "letterSpacing": {
      "type": "boolean"
    },
    "transcriptByDefault": {
      "type": "boolean"
    },
    "replaceHandwriting": {
      "type": "boolean"
    },
    "highContrast": {
      "type": "boolean"
    },
    "reducePaperTexture": {
      "type": "boolean"
    },
    "colorVision": {
      "type": "string",
      "enum": [
        "default",
        "protanopia",
        "deuteranopia",
        "tritanopia"
      ]
    },
    "motion": {
      "type": "string",
      "enum": [
        "system",
        "reduced",
        "full"
      ]
    },
    "hints": {
      "type": "object",
      "properties": {
        "preset": {
          "anyOf": [
            {
              "type": "number",
              "enum": [
                0,
                1,
                2,
                3
              ]
            },
            {
              "type": "string",
              "const": "custom"
            }
          ]
        },
        "unreadBadges": {
          "type": "boolean"
        },
        "exhaustedTerms": {
          "type": "boolean"
        },
        "placeCounters": {
          "type": "boolean"
        },
        "whereToLook": {
          "type": "boolean"
        },
        "groupCounter": {
          "type": "boolean"
        },
        "progressiveHints": {
          "type": "boolean"
        }
      },
      "required": [
        "preset",
        "unreadBadges",
        "exhaustedTerms",
        "placeCounters",
        "whereToLook",
        "groupCounter",
        "progressiveHints"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ]
    },
    "showTimer": {
      "type": "boolean"
    },
    "volume": {
      "type": "object",
      "properties": {
        "master": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "music": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambience": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sfx": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ui": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "master",
        "music",
        "ambience",
        "sfx",
        "ui"
      ],
      "additionalProperties": false
    },
    "mono": {
      "type": "boolean"
    },
    "muteInBackground": {
      "type": "boolean"
    },
    "haptics": {
      "type": "boolean"
    },
    "longPressMs": {
      "type": "number",
      "enum": [
        300,
        400,
        600
      ]
    },
    "confirmClear": {
      "type": "boolean"
    },
    "inputGlyphs": {
      "type": "string",
      "enum": [
        "auto",
        "keyboard",
        "gamepad"
      ]
    },
    "language": {
      "type": "string",
      "enum": [
        "system",
        "fr",
        "en"
      ]
    }
  },
  "required": [
    "textScale",
    "readingFont",
    "lineSpacing",
    "letterSpacing",
    "transcriptByDefault",
    "replaceHandwriting",
    "highContrast",
    "reducePaperTexture",
    "colorVision",
    "motion",
    "hints",
    "validation",
    "showTimer",
    "volume",
    "mono",
    "muteInBackground",
    "haptics",
    "longPressMs",
    "confirmClear",
    "inputGlyphs"
  ],
  "additionalProperties": false
}
