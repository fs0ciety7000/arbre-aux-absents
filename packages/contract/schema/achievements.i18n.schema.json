{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "required": [
      "title",
      "description"
    ],
    "additionalProperties": false
  }
}
