{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "map": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "attribution": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "places": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "map",
    "places"
  ],
  "additionalProperties": false
}
