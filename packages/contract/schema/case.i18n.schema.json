{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "subtitle": {
      "type": "string",
      "pattern": "\\S"
    },
    "credits": {
      "type": "array",
