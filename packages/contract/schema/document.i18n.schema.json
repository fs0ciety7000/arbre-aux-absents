{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "author": {
      "type": "string",
      "pattern": "\\S"
    },
    "archive": {
      "type": "string",
      "pattern": "\\S"
    },
    "illustration": {
      "type": "object",
      "properties": {
        "alt": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "alt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "title"
  ],
  "additionalProperties": false
}
