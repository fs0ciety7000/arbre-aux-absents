{
  "name": "arbre-aux-absents",
  "version": "0.0.0",
  "private": true,
  "description": "L'Arbre aux absents : jeu d'enquête généalogique (CM Interactive, CM Creative Lab).",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "npm run content:build && npm run dev -w @arbre/game",
    "dev:site": "npm run content:build && npm run dev -w @arbre/site",
    "dev:tauri": "npm run tauri:dev",
    "check": "npm run content:build && npm run format:check && npm run lint && npm run typecheck && npm run contrast:check -w @arbre/ui && npm run test && npm run content:check",
    "build": "npm run content:build && npm run build -w @arbre/game && npm run build -w @arbre/site",
    "tauri:dev": "npm run tauri:dev -w @arbre/game",
    "tauri:build": "npm run tauri:build -w @arbre/game",
    "tauri:android": "npm run tauri:android -w @arbre/game",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/content-check.ts",
    "content:build": "tsx scripts/content-build.ts",
    "content:solve": "tsx scripts/content-solve.ts",
    "schemas:json": "npm run schemas:json -w @arbre/contract",
    "package:itch": "tsx scripts/package-itch.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
