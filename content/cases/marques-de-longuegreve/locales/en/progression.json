  "report": {
    "q1-evacuation": {
      "prompt": "Why was the island evacuated in 1908?",
      "options": {
        "fievre": {
          "label": "An epidemic of typhoid fever (health certificate of 13 March 1908)"
        },
        "concession": {
          "label": "For the amber concession: the certificate was signed before the visit"
        },
        "non-etabli": {
          "label": "Not established"
        }
      }
    },
    "q2-depart-de-blaise": {
      "prompt": "Why did Blaise Goémard leave the island in 1870?",
      "options": {
        "vol": {
          "label": "Banished for stealing amber (chapel register)"
        },
        "a-la-place": {
          "label": "Banished in place of his brother Josse"
        },
        "non-etabli": {
          "label": "Not established"
        }
      }
    },
    "q3-maison-cormaud": {
      "prompt": "Who inherits the Cormaud house?",
      "options": {
        "desherence": {
          "label": "No one: the house has died out (escheat)"
        },
        "noel": {
          "label": "The descendants of Noël Cormaud, Siméon's legatee"
        },
        "non-etabli": {
          "label": "Not established"
        }
      }
    },
    "q4-legs-de-blaise": {
      "prompt": "What did Blaise Garnaud leave the four houses?",
      "options": {
        "rien": {
          "label": "Nothing: the Company went to his son (testament)"
        },
        "coffre": {
          "label": "Sixteen years of shore shares, in safe-deposit box No. 108"
        },
        "non-etabli": {
          "label": "Not established"
        }
      }
    },
    "decision": {
      "prompt": "The Office's decision",
      "options": {
        "indemniser": {
          "label": "Compensate: settle the list of beneficiaries of the four heads of the 1868 roll; the island passes to the State against compensation."
        },
        "spoliation": {
          "label": "Recognise the despoilment: find that the 1908 evacuation had no sanitary grounds; seek the annulment of the concession and the reparation owed to the four houses.",
          "unavailableReason": "No document contradicts the 1908 certificate."
        },
        "rendre-l-ile": {
          "label": "Return the island: refuse the expropriation; the island remains undivided among the four houses, and the reserve will be made by agreement with them.",
          "unavailableReason": "The Cormaud house has no established beneficiary."
        }
      }
    }
