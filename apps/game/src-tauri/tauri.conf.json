{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "L’Arbre aux absents",
  "mainBinaryName": "arbre-aux-absents",
  "version": "../package.json",
  "identifier": "org.cardormedia.arbreauxabsents",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run tauri:before-dev",
    "beforeBuildCommand": "npm run tauri:before-build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "L'Arbre aux absents",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CM Interactive",
    "copyright": "© CM Interactive, CM Creative Lab",
    "category": "PuzzleGame",
    "shortDescription": "Jeu d'enquête généalogique dans un monde imaginaire.",
    "longDescription": "Reconstituez l'arbre d'une famille en croisant des archives, un moteur de recherche fictif et une carte illustrée.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "section": "games"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
