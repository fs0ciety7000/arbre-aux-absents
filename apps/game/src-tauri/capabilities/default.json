{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Droits minimaux du jeu : fenêtre, sauvegardes sous $APPDATA/saves/, dialogues d'export/import, liens externes limités au site, à la page itch.io (D11) et aux releases GitHub du jeu (APK Android d'une nouvelle version, D18).",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows", "android", "iOS"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-remove",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/saves" }, { "path": "$APPDATA/saves/**" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://arbre.cardormedia.com/*" },
        { "url": "https://cardorinteractive.itch.io/*" },
        { "url": "https://github.com/fs0ciety7000/arbre-aux-absents/releases/*" }
      ]
    }
  ]
}
