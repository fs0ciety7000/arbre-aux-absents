{
  "name": "@arbre/game",
  "version": "1.0.1",
  "private": true,
  "description": "Le jeu : SPA Vite + Svelte 5 (web, itch.io, Tauri 2).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "tauri": "tauri",
    "tauri:before-dev": "npm --prefix ../.. run content:build && vite --mode tauri",
    "tauri:before-build": "npm --prefix ../.. run content:build && vite build --mode tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android build",
    "tauri:icons": "tauri icon src-tauri/icons/app-icon.json"
  },
  "dependencies": {
    "@arbre/contract": "*",
    "@arbre/engine": "*",
    "@arbre/map": "*",
    "@arbre/ui": "*",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "svelte": "^5.57.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.2",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.3.4"
  }
}
